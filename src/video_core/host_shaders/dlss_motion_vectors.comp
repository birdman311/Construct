// Camera motion vectors for NVIDIA DLSS: for every rendered pixel, where the surface it shows was
// on screen in the previous frame, in render pixels (previous minus current, without jitter).

#version 460 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (set = 0, binding = 0) uniform sampler2D depth_texture;
layout (set = 0, binding = 1, rg16f) uniform writeonly image2D motion_vectors;

layout (push_constant) uniform PushConstants {
    // Current normalized device coordinates (z included) to the previous frame's clip space.
    mat4 reprojection;
    // Guest viewport transform: window = ndc * scale + translate.
    vec4 viewport_xy;      // scale x, scale y, translate x, translate y
    vec4 depth_and_jitter; // scale z, translate z, jitter x, jitter y (pixels added this frame)
    uvec2 size;
};

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const float depth = texelFetch(depth_texture, ivec2(pixel), 0).r;
    // Where the surface this pixel shows would be without this frame's jitter.
    const vec2 window = vec2(pixel) + 0.5 - depth_and_jitter.zw;
    const vec3 ndc = vec3((window - viewport_xy.zw) / viewport_xy.xy,
                          (depth - depth_and_jitter.y) / depth_and_jitter.x);
    const vec4 previous = reprojection * vec4(ndc, 1.0);
    vec2 motion = vec2(0.0);
    if (abs(previous.w) > 1e-6) {
        const vec2 previous_window = previous.xy / previous.w * viewport_xy.xy + viewport_xy.zw;
        motion = previous_window - window;
    }
    imageStore(motion_vectors, ivec2(pixel), vec4(motion, 0.0, 0.0));
}
